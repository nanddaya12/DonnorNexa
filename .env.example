# =====================================================================
# DonorNexa Production Environment Configuration
# Copy this file to .env and adjust values for your server environment.
# =====================================================================

# Environment mode: 'production' or 'development'
DN_ENV=production

# Database Connection (MySQL 8 / MariaDB 10.4+)
DN_DB_HOST=127.0.0.1
DN_DB_PORT=3306
DN_DB_NAME=donornexa
DN_DB_USER=root
DN_DB_PASS=

# Application Timezone
DN_TIMEZONE=Asia/Karachi
